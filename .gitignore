# ============ Visual Studio / MSVC 构建产物 ============
# .vs 里是 VS 的缓存，单个 .ipch 就有 200+ MB，绝对不能进仓库
.vs/
*.ipch
*.pch
*.obj
*.iobj
*.ipdb
*.idb
*.pdb
*.ilk
*.exp
*.lib
*.recipe
*.tlog/
*.Build.CppClean.log
Browse.VC.db
*.FileListAbsolute.txt

# ============ Python ============
__pycache__/
*.pyc

# ============ 旧构建产物（保留合并版仅一处，见文件说明）============
# 合并版正式产物：AstlibraMod/AstlibraMod/x64/Release/AstlibraMod.dll
AstlibraMod/Release/AstlibraMod.dll
AstlibraMod/x64/Debug/AstlibraMod.dll
AstlibraMod/x64/Release/AstlibraMod.dll
AstlibraMod/x64dbg_mcp.dp64
# 零散编译产物。
# 注意：git rm --cached 之后必须同时写进这里，否则下一次 git add -A 会把它重新加回来。
AstlibraMod/AstlibraMod/test.exe
AstlibraMod/x64/Release/DLLLoader64_F3E4.exe

# ============ CMake 构建目录 ============
build/

# ============ 工具/技能/规范文件夹（整体不进仓库）============
# 含 567 MB 第三方工具（.tools）和一个独立的模板仓库（模板），整体不公开。
Mod开发工具、技能、规范/

# ============ 嵌套的独立 git 仓库 ============
# 每个都是单独克隆来的仓库。直接提交只会存成一个空壳（真正的文件不会进仓库），
# 所以整体排除；要纳管的话应该用 git submodule。
AstlibraMod/universal-modder/
AstlibraMod/.tmp-x64dbg-mcp/
AstlibraMod/tools/cheatengine-mcp-bridge/

# ============ 临时目录 ============
.tmp-*/
.playwright-mcp/

# ============ 运行时日志 ============
*.log
